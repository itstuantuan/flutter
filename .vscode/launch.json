{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "iPhone 真机调试（开发签名）",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=env/development.local.json"
      ],
      "preLaunchTask": "Prepare Google OAuth development"
    },
    {
      "name": "iPhone 真机 Release（开发签名）",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "env": {
        "XCODE_XCCONFIG_FILE": "${workspaceFolder}/ios/Flutter/DeviceRelease.xcconfig"
      },
      "toolArgs": [
        "--dart-define-from-file=env/development.local.json"
      ],
      "preLaunchTask": "Prepare Google OAuth development"
    },
    {
      "name": "iPhone 真机 Release（正式接口·开发签名）",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "env": {
        "XCODE_XCCONFIG_FILE": "${workspaceFolder}/ios/Flutter/DeviceRelease.xcconfig"
      },
      "toolArgs": [
        "--dart-define-from-file=env/production.local.json"
      ],
      "preLaunchTask": "Prepare Google OAuth production"
    },
    {
      "name": "Flutter Debug",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=env/development.local.json"
      ],
      "preLaunchTask": "Prepare Google OAuth development"
    },
    {
      "name": "Flutter Profile",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": [
        "--dart-define-from-file=env/development.local.json"
      ],
      "preLaunchTask": "Prepare Google OAuth development"
    },
    {
      "name": "Flutter Release",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define-from-file=env/production.local.json"
      ],
      "preLaunchTask": "Prepare Google OAuth production"
    }
  ]
}
