{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter Debug",
      "request": "launch",
      "type": "dart",
      "flutterMode": "debug",
      "toolArgs": [
        "--dart-define-from-file=env/development.local.json"
      ],
      "preLaunchTask": "Prepare Google OAuth development"
    },
    {
      "name": "Flutter Profile",
      "request": "launch",
      "type": "dart",
      "flutterMode": "profile",
      "toolArgs": [
        "--dart-define-from-file=env/development.local.json"
      ],
      "preLaunchTask": "Prepare Google OAuth development"
    },
    {
      "name": "Flutter Release",
      "request": "launch",
      "type": "dart",
      "flutterMode": "release",
      "toolArgs": [
        "--dart-define-from-file=env/production.json"
      ],
      "preLaunchTask": "Prepare Google OAuth production"
    }
  ]
}
